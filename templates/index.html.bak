<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TomatoIQ: Kisan AI – SMART TOMATO LEAF DISEASE & CROP CLINIC</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        
        body { 
            background: radial-gradient(circle at 50% 0%, #0d241d 0%, #050d0a 55%, #020504 100%);
            color: #f1f5f9; 
            min-height: 100vh; 
            overflow-y: auto; 
            padding-bottom: 40px; 
        }
        
        nav { 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            padding: 18px 48px; 
            background: rgba(6, 18, 14, 0.9); 
            backdrop-filter: blur(14px); 
            border-bottom: 1px solid rgba(52, 211, 153, 0.2); 
            position: sticky; 
            top: 0; 
            z-index: 100; 
        }
        .brand-container { display: flex; align-items: center; gap: 12px; }
        .brand-icon { font-size: 28px; }
        .brand-title { font-size: 20px; font-weight: 900; color: #34d399; letter-spacing: -0.5px; }
        .brand-tag { font-size: 11px; font-weight: 700; color: #fbbf24; text-transform: uppercase; letter-spacing: 0.8px; margin-top: 1px; }

        .nav-links { display: flex; gap: 24px; align-items: center; }
        .nav-links a { color: #94a3b8; text-decoration: none; font-size: 14px; font-weight: 600; transition: 0.2s; }
        .nav-links a.active, .nav-links a:hover { color: #34d399; }
        .lang-select { background: #0c1e18; color: #fff; border: 1px solid #10b981; padding: 8px 14px; border-radius: 10px; font-size: 13px; outline: none; cursor: pointer; }

        .container { max-width: 1040px; margin: 40px auto; padding: 0 20px; text-align: center; }
        .title { font-size: 38px; font-weight: 900; margin-bottom: 10px; background: linear-gradient(135deg, #34d399 20%, #10b981 50%, #f97316 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; letter-spacing: -0.5px; }
        .subtitle { font-size: 16px; color: #cbd5e1; margin-bottom: 8px; font-weight: 600; }
        .disclaimer { font-size: 12.5px; color: #64748b; margin-bottom: 28px; }

        .upload-card { 
            background: rgba(8, 20, 16, 0.7); 
            border: 2px dashed #10b981; 
            border-radius: 24px; 
            padding: 48px 30px; 
            position: relative; 
            cursor: pointer; 
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); 
            box-shadow: 0 10px 30px rgba(0,0,0,0.6); 
        }
        .upload-card:hover { border-color: #34d399; background: rgba(12, 30, 24, 0.85); box-shadow: 0 0 25px rgba(16, 185, 129, 0.25); transform: translateY(-2px); }
        .cloud-icon { width: 64px; height: 64px; fill: #10b981; margin-bottom: 16px; }
        .upload-title { font-size: 18px; font-weight: 700; margin-bottom: 8px; color: #f1f5f9; }
        .upload-or { font-size: 13px; color: #64748b; margin: 10px 0; }
        .browse-btn { background: linear-gradient(135deg, #10b981, #059669); color: white; border: none; padding: 11px 26px; border-radius: 12px; font-size: 14px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; transition: 0.2s; box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3); }
        .browse-btn:hover { background: linear-gradient(135deg, #34d399, #10b981); transform: translateY(-1px); }
        .file-hint { font-size: 12px; color: #64748b; margin-top: 15px; }

        #preview-section { display: none; margin-top: 40px; }
        .preview-title { font-size: 20px; font-weight: 700; margin-bottom: 18px; color: #34d399; }
        .preview-img-box { width: 100%; max-width: 420px; background: #030806; border-radius: 20px; overflow: hidden; margin: 0 auto 20px auto; border: 2px solid #10b981; padding: 10px; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 20px rgba(16, 185, 129, 0.2); }
        .preview-img-box img { width: 100%; height: auto; max-height: 440px; object-fit: contain; border-radius: 12px; display: block; }

        .analyze-btn { background: linear-gradient(135deg, #10b981, #047857); color: white; border: none; padding: 14px 44px; border-radius: 14px; font-size: 16px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; transition: 0.25s; box-shadow: 0 4px 20px rgba(16, 185, 129, 0.4); border: 1px solid rgba(52, 211, 153, 0.3); }
        .analyze-btn:hover { background: linear-gradient(135deg, #34d399, #10b981); transform: translateY(-2px); box-shadow: 0 6px 25px rgba(16, 185, 129, 0.55); }

        #result-section { display: none; margin-top: 45px; text-align: left; }
        .stat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 25px; }
        .stat-card { background: rgba(10, 24, 20, 0.7); backdrop-filter: blur(12px); padding: 22px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.08); text-align: center; box-shadow: 0 10px 25px rgba(0,0,0,0.4); }
        .stat-card.green { border-color: rgba(16,185,129,0.4); }
        .stat-card.red { border-color: rgba(239,68,68,0.4); }
        .stat-card.blue { border-color: rgba(59,130,246,0.4); }
        .stat-val { font-size: 28px; font-weight: 900; margin-top: 8px; }
        .stat-card.green .stat-val { color: #34d399; }
        .stat-card.red .stat-val { color: #f87171; }
        .stat-card.blue .stat-val { color: #60a5fa; }
        .stat-label { font-size: 13px; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }

        .images-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 25px; }
        .img-card { background: rgba(10, 24, 20, 0.7); backdrop-filter: blur(12px); padding: 18px; border-radius: 22px; text-align: center; border: 1px solid rgba(52, 211, 153, 0.15); box-shadow: 0 10px 25px rgba(0,0,0,0.4); }
        .img-card h4 { font-size: 14px; color: #34d399; margin-bottom: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
        .img-wrapper { width: 100%; background: #030806; border-radius: 14px; display: flex; align-items: center; justify-content: center; padding: 8px; min-height: 320px; }
        .img-wrapper img { width: 100%; height: auto; max-height: 420px; object-fit: contain; border-radius: 8px; display: block; }

        .rx-card { background: linear-gradient(145deg, #091a14, #04100c); border: 1.5px solid #10b981; border-radius: 22px; padding: 28px; margin-top: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
        .rx-header-row { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; }
        .rx-card h3 { color: #f59e0b; font-size: 20px; font-weight: 800; }
        .engine-badge { background: rgba(16, 185, 129, 0.15); border: 1px solid #10b981; color: #34d399; font-size: 11.5px; font-weight: 700; padding: 4px 12px; border-radius: 20px; }
        .rx-field { margin-bottom: 12px; font-size: 15px; line-height: 1.6; color: #cbd5e1; }
        .rx-field strong { color: #f8fafc; }

        /* Offline Audio Controls */
        .audio-container { margin-top: 18px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,0.08); display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
        .btn-audio-speak { background: linear-gradient(135deg, #10b981, #059669); color: white; border: none; padding: 10px 22px; border-radius: 12px; font-weight: 700; font-size: 14px; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35); transition: 0.2s; }
        .btn-audio-speak:hover { background: linear-gradient(135deg, #34d399, #10b981); transform: translateY(-1px); }

        .action-bar { margin-top: 25px; display: flex; gap: 16px; justify-content: flex-end; }
        .btn-view-report { background: linear-gradient(135deg, #10b981, #059669); color: white; border: none; padding: 13px 28px; border-radius: 12px; font-size: 15px; font-weight: 700; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: 0.2s; box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3); border: 1px solid rgba(52, 211, 153, 0.3); }
        .btn-view-report:hover { background: linear-gradient(135deg, #34d399, #10b981); transform: translateY(-2px); }

        /* Benchmarks Section */
        .section-header { text-align: left; margin: 60px 0 20px 0; display: flex; align-items: center; justify-content: space-between; }
        .section-header h2 { font-size: 22px; font-weight: 800; color: #34d399; display: flex; align-items: center; gap: 10px; }
        .section-header p { font-size: 13.5px; color: #94a3b8; }
        .section-header a { font-size: 13.5px; color: #10b981; text-decoration: none; font-weight: 700; transition: 0.2s; }
        .section-header a:hover { color: #34d399; text-decoration: underline; }

        .bench-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 30px; text-align: left; }
        .bench-card { background: rgba(8, 22, 18, 0.7); backdrop-filter: blur(12px); border-radius: 18px; padding: 20px 18px; border: 1px solid rgba(52, 211, 153, 0.2); box-shadow: 0 10px 25px rgba(0,0,0,0.4); position: relative; overflow: hidden; }
        .bench-card::before { content: ""; position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: #10b981; }
        .bench-label { font-size: 12.5px; color: #94a3b8; font-weight: 700; text-transform: uppercase; letter-spacing: 0.6px; }
        .bench-value { font-size: 30px; font-weight: 900; color: #34d399; margin: 6px 0 2px 0; }
        .bench-sub { font-size: 11.5px; color: #64748b; font-weight: 500; }

        /* Recent Reports Table Card */
        .recent-table-card { background: rgba(8, 22, 18, 0.7); backdrop-filter: blur(12px); border-radius: 20px; overflow: hidden; border: 1px solid rgba(52, 211, 153, 0.18); box-shadow: 0 15px 35px rgba(0,0,0,0.5); text-align: left; margin-bottom: 50px; }
        .recent-table { width: 100%; border-collapse: collapse; }
        .recent-table th { background: linear-gradient(90deg, #064e3b, #047857); padding: 14px 18px; font-size: 13px; font-weight: 800; color: #f1f5f9; text-transform: uppercase; letter-spacing: 0.5px; }
        .recent-table td { padding: 14px 18px; font-size: 13.5px; color: #cbd5e1; border-bottom: 1px solid rgba(255,255,255,0.05); vertical-align: middle; }
        .recent-table tbody tr:hover { background: rgba(16, 185, 129, 0.05); }

        .dt-box { display: inline-flex; align-items: center; gap: 8px; font-family: ui-monospace, Menlo, Monaco, monospace; font-size: 12.5px; }
        .dt-d { color: #f8fafc; font-weight: 700; }
        .dt-s { color: #10b981; font-weight: 900; background: rgba(16, 185, 129, 0.15); padding: 1px 6px; border-radius: 4px; }
        .dt-t { color: #94a3b8; font-weight: 600; }

        .tag-pill { padding: 4px 12px; border-radius: 20px; font-size: 11.5px; font-weight: 700; display: inline-block; }
        .pill-healthy { background: rgba(16, 185, 129, 0.18); color: #34d399; border: 1px solid rgba(52, 211, 153, 0.4); }
        .pill-early { background: rgba(249, 115, 22, 0.18); color: #fb923c; border: 1px solid rgba(251, 146, 60, 0.4); }
        .pill-late { background: rgba(239, 68, 68, 0.18); color: #f87171; border: 1px solid rgba(248, 113, 113, 0.4); }
        .pill-curl { background: rgba(234, 179, 8, 0.18); color: #fde047; border: 1px solid rgba(253, 224, 71, 0.4); }

        .btn-view-quick { background: #10b981; color: white; text-decoration: none; padding: 6px 14px; border-radius: 8px; font-size: 12px; font-weight: 700; transition: 0.2s; display: inline-flex; align-items: center; gap: 4px; }
        .btn-view-quick:hover { background: #059669; }

        /* Developer Footer */
        footer { margin-top: 50px; padding: 35px 20px 20px 20px; border-top: 1px solid rgba(52, 211, 153, 0.2); text-align: center; background: rgba(4, 12, 10, 0.6); }
        .footer-badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(52, 211, 153, 0.35); padding: 6px 16px; border-radius: 20px; font-size: 12.5px; font-weight: 700; color: #34d399; margin-bottom: 14px; }
        .footer-desc { font-size: 14px; color: #cbd5e1; max-width: 650px; margin: 0 auto 16px auto; line-height: 1.6; }
        .footer-author { font-size: 14.5px; font-weight: 700; color: #f8fafc; margin-bottom: 8px; }
        .github-link { display: inline-flex; align-items: center; gap: 8px; background: #0f2920; color: #34d399; padding: 9px 20px; border-radius: 10px; font-size: 13.5px; font-weight: 700; text-decoration: none; border: 1px solid #10b981; transition: all 0.25s ease; }
        .github-link:hover { background: #10b981; color: #ffffff; box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4); transform: translateY(-2px); }
        .footer-copy { font-size: 11.5px; color: #64748b; margin-top: 22px; }
    </style>
</head>
<body>

    <nav>
        <div class="brand-container">
            <span class="brand-icon">🌿</span>
            <div>
                <div class="brand-title" id="logoText">TomatoIQ: Kisan AI</div>
                <div class="brand-tag" id="logoTag">SMART TOMATO LEAF DISEASE & CROP CLINIC</div>
            </div>
        </div>
        <div class="nav-links">
            <a href="/" class="active" id="navHome">Home</a>
            <a href="/history" id="navHistory">📜 History</a>
            <select id="langSelect" class="lang-select" style="background: #091a13; color: #34d399; border: 1px solid rgba(52, 211, 153, 0.45); padding: 8px 14px; border-radius: 10px; font-weight: 600; font-size: 0.92rem; outline: none; cursor: pointer; box-shadow: 0 0 12px rgba(16, 185, 129, 0.15);">
                        <option value="English" style="background: #091a13; color: #ecfdf5;">🌐 English</option>
                        <option value="Hindi" style="background: #091a13; color: #ecfdf5;">🌐 हिन्दी (Hindi)</option>
                        <option value="Kannada" style="background: #091a13; color: #ecfdf5;">🌐 ಕನ್ನಡ (Kannada)</option>
                    </select>
        </div>
    </nav>

    <div class="container">
        <h1 class="title" id="mainTitle">TomatoIQ: Kisan AI</h1>
        <p class="subtitle" id="mainSubtitle">SMART TOMATO LEAF DISEASE & CROP CLINIC</p>
        <p class="disclaimer" id="mainDisclaimer">Vision classification (ResNet50 8-Bit INT8) & reasoning advisory (Llama 3.2) run 100% offline on-device.</p>

        <!-- Drop Box -->
        <div class="upload-card" id="dropArea">
            <svg class="cloud-icon" viewBox="0 0 24 24"><path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z"/></svg>
            <div class="upload-title" id="dropTitle">Drag & Drop your leaf image here</div>
            <div class="upload-or" id="dropOr">or</div>
            <button class="browse-btn" onclick="document.getElementById('fileInput').click()" id="browseBtnText">📁 Browse Files</button>
            <input type="file" id="fileInput" accept="image/*" style="display: none;">
            <div class="file-hint" id="fileHint">Supported formats: JPG, PNG, JPEG (Full view, no crop)</div>
        </div>

        <!-- Uploaded Preview -->
        <div id="preview-section">
            <h3 class="preview-title" id="previewTitle">Uploaded Leaf Image</h3>
            <div class="preview-img-box">
                <img id="previewImg" src="" alt="Uploaded Leaf">
            </div>
            <button class="analyze-btn" id="analyzeBtn">⚡ Start Diagnostic Scan</button>
        </div>

        <!-- Result Section -->
        <div id="result-section">
            <div class="stat-grid">
                <div class="stat-card green">
                    <div class="stat-label" id="curableLabel">Recovery Chance</div>
                    <div class="stat-val" id="curableVal">--%</div>
                </div>
                <div class="stat-card red">
                    <div class="stat-label" id="severityLabel">Affected Area</div>
                    <div class="stat-val" id="severityVal">--%</div>
                </div>
                <div class="stat-card blue">
                    <div class="stat-label" id="confLabel">Confidence</div>
                    <div class="stat-val" id="confVal">--%</div>
                </div>
            </div>

            <div class="images-grid">
                <div class="img-card">
                    <h4 id="origHeading">Field Leaf Image</h4>
                    <div class="img-wrapper">
                        <img id="resOrigImg" src="">
                    </div>
                </div>
                <div class="img-card">
                    <h4 id="maskHeading">Damage Lesion Mask (Shadows Removed)</h4>
                    <div class="img-wrapper">
                        <img id="resMaskImg" src="">
                    </div>
                </div>
            </div>

            <div class="rx-card">
                <div class="rx-header-row">
                    <h3 id="diseaseName">Diagnosed Condition</h3>
                    <span class="engine-badge" id="engineBadge">🧠 Llama 3.2 (ExecuTorch)</span>
                </div>
                <div class="rx-field"><strong id="rxLblMed">💊 Prescribed Rx:</strong> <span id="rxMedicine">--</span></div>
                <div class="rx-field"><strong id="rxLblDose">⚖️ Required Dose:</strong> <span id="rxDose">--</span></div>
                <div class="rx-field"><strong id="rxLblAction">📌 Advisory:</strong> <span id="rxAction">--</span></div>

                <!-- Offline Audio Prescription Voice Button & Player -->
                <div class="audio-container">
                    <button type="button" class="btn-audio-speak" id="playAudioBtn" onclick="playOfflineAudio()">
                        🔊 <span id="audioBtnText">Kisan Audio Salah Sunein</span>
                    </button>
                    <audio id="offlineAudioPlayer" controls style="display: none; height: 38px;"></audio>
                </div>
            <div style="margin-top: 22px; padding: 18px 20px; background: rgba(6, 13, 10, 0.85); border: 1px solid rgba(52, 211, 153, 0.3); border-radius: 14px;">
                <div style="font-weight: 700; color: #34d399; font-size: 1rem; margin-bottom: 8px;">
                    💬 Kisan AI Follow-Up Assistant (Powered by On-Device Llama 3.2)
                </div>
                <p style="color: #94a3b8; font-size: 0.85rem; margin-bottom: 12px;">
                    Ask follow-up questions about spray timing, rain precautions, or crop care in English, Hindi, or Kannada.
                </p>
                <div id="chatHistoryBox" style="max-height: 190px; overflow-y: auto; margin-bottom: 12px; display: flex; flex-direction: column; gap: 8px; font-size: 0.9rem;"></div>
                <div style="display: flex; gap: 10px;">
                    <input type="text" id="chatInput" placeholder="Ask a question (e.g., When is the best time to spray?)..."
                        style="flex: 1; padding: 10px 14px; border-radius: 10px; border: 1px solid rgba(52, 211, 153, 0.35); background: #0c1813; color: #f8fafc; font-size: 0.92rem;"
                        onkeydown="if(event.key==='Enter') sendKisanChat()" />
                    <button type="button" id="chatSendBtn" onclick="sendKisanChat()"
                        style="padding: 10px 18px; border-radius: 10px; border: none; background: linear-gradient(135deg, #10b981, #059669); color: #03150e; font-weight: 700; cursor: pointer;">
                        Ask AI
                    </button>
                </div>
            </div>

            </div>

            <div class="action-bar">
                <a href="#" id="viewFullReportBtn" class="btn-view-report">📄 View & Download Full Report →</a>
            </div>
        </div>

        <!-- System Benchmark Metrics (Verified 8-Bit QAT ResNet50) -->
        <div class="section-header">
            <div>
                <h2 id="benchHeading">⚡ System Diagnostic Performance & Benchmarks</h2>
                
            </div>
        </div>

        <div class="bench-grid">
            <div class="bench-card">
                <div class="bench-label" id="lblAcc">Overall Accuracy</div>
                <div class="bench-value">99.06%</div>
                <div class="bench-sub" id="lblAccSub">4-Class QAT INT8 Verified</div>
            </div>
            <div class="bench-card">
                <div class="bench-label" id="lblPrec">Model Precision</div>
                <div class="bench-value">99.04%</div>
                <div class="bench-sub" id="lblPrecSub">Macro-averaged precision</div>
            </div>
            <div class="bench-card">
                <div class="bench-label" id="lblRecall">Sensitivity / Recall</div>
                <div class="bench-value">99.04%</div>
                <div class="bench-sub" id="lblRecallSub">Macro-averaged recall</div>
            </div>
            <div class="bench-card">
                <div class="bench-label" id="lblF1">F1-Score Benchmark</div>
                <div class="bench-value">99.04%</div>
                <div class="bench-sub" id="lblF1Sub">25.46 MB INT8 quantized</div>
            </div>
        </div>

        <!-- Recent Diagnostic Reports -->
        <div class="section-header">
            <div>
                <h2 id="recentHeading">📋 Recent Clinical Diagnostics</h2>
                <p id="recentSub">Quick access to the last 5 leaf pathology evaluations on this device</p>
            </div>
            <a href="/history" id="recentViewAll">View Full History (All) →</a>
        </div>

        <div class="recent-table-card">
            {% if recent_records %}
            <table class="recent-table">
                <thead>
                    <tr>
                        <th id="thId">ID</th>
                        <th id="thDate">Date & Time</th>
                        <th id="thDiag">Diagnosed Disease</th>
                        <th id="thConf">Confidence</th>
                        <th id="thAction">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for r in recent_records %}
                    <tr>
                        <td><strong>#{{ r.id }}</strong></td>
                        <td>
                            <div class="dt-box">
                                {% set ts = r.timestamp %}
                                {% if "  |  " in ts %}
                                    {% set parts = ts.split("  |  ") %}
                                    <span class="dt-d">{{ parts[0] }}</span>
                                    <span class="dt-s">|</span>
                                    <span class="dt-t">{{ parts[1] }}</span>
                                {% elif " " in ts %}
                                    {% set parts = ts.split(" ") %}
                                    <span class="dt-d">{{ parts[0] }}</span>
                                    <span class="dt-s">|</span>
                                    <span class="dt-t">{{ parts[1:]|join(' ') }}</span>
                                {% else %}
                                    <span>{{ ts }}</span>
                                {% endif %}
                            </div>
                        </td>
                        <td>
                            <span class="tag-pill recent-tag {% if r.pred_key == 'class_D' %}pill-healthy{% elif r.pred_key == 'class_A' %}pill-early{% elif r.pred_key == 'class_B' %}pill-late{% else %}pill-curl{% endif %}" data-key="{{ r.pred_key }}">
                                {% if r.pred_key == 'class_D' %}Healthy
                                {% elif r.pred_key == 'class_A' %}Early Blight
                                {% elif r.pred_key == 'class_B' %}Late Blight
                                {% else %}Yellow Leaf Curl Virus
                                {% endif %}
                            </span>
                        </td>
                        <td><strong style="color: #60a5fa;">{{ r.confidence }}%</strong></td>
                        <td>
                            <a href="/report/{{ r.id }}?lang={{ r.language }}" class="btn-view-quick recent-report-link">📄 View Report</a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <div id="noRecentMsg" style="padding: 40px; text-align: center; color: #64748b;">
                No recent evaluations found. Upload a leaf image above to generate your first diagnostic report.
            </div>
            {% endif %}
        </div>

    </div>

