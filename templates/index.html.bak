                benchH: '⚡ ସିଷ୍ଟମ ନିଦାନ ସଠିକତା ଏବଂ ପ୍ରଦର୍ଶନ',
                benchS: '8-Bit QAT ResNet50 INT8 + Llama 3.2 ନେଟୱାର୍କ ଦ୍ୱାରା ପ୍ରମାଣିତ',
                lblAcc: 'ମୋଟ ସଠିକତା (Accuracy)', lblAccS: '1,912 / 1,914 ପ୍ରମାଣିତ INT8',
                lblPrec: 'ମଡେଲ ପ୍ରିସିସନ', lblPrecS: 'ଭୁଲ ଚିହ୍ନଟ ହେବାର କମ ସମ୍ଭାବନା',
                lblRecall: 'ସମ୍ବେଦନଶୀଳତା (Recall)', lblRecallS: 'ରୋଗ ଚିହ୍ନଟ କରିବାର କ୍ଷମତା',
                lblF1: 'F1-ସ୍କୋର', lblF1S: '25.46 MB INT8 ମଡେଲ',
                recentH: '📋 ନିକଟରେ କରାଯାଇଥିବା ପରୀକ୍ଷଣ',
                recentS: 'ଏହି ଡିଭାଇସରେ ଶେଷ ୫ଟି ପତ୍ର ପରୀକ୍ଷଣ ରିପୋର୍ଟ',
                recentAll: 'ସମ୍ପୂର୍ଣ୍ଣ ଇତିହାସ ଦେଖନ୍ତୁ →',
                thId: 'କ୍ର.', thDate: 'ତାରିଖ ଓ ସମୟ', thDiag: 'ରୋଗର ନାମ', thConf: 'ସଠିକତା', thAction: 'ରିପୋର୍ଟ',
                btnViewRec: '📄 ରିପୋର୍ଟ ଦେଖନ୍ତୁ',
                ftBadge: '🍅 ResNet50 INT8 ଏବଂ ଅନ୍-ଡିଭାଇସ୍ Llama 3.2 (ExecuTorch) ଦ୍ୱାରା ପରିଚାଳିତ',
                ftDesc: 'ଚାଷୀ ଭାଇମାନଙ୍କ ପାଇଁ ଇଣ୍ଟରନେଟ ବିନା ଚାଲୁଥିବା ଏକ AI ବ୍ୟବସ୍ଥା ଯାହା ଟମାଟୋ ପତ୍ର ଦେଖି ରୋଗ ଏବଂ ଉପଯୁକ୍ତ ଔଷଧ ବତାଏ।',
                ftAuthor: 'Developed & Engineered with Precision by Sahil Sexsena',
                ftCopy: '© 2026 TomatoIQ: କିଷାନ AI • ଅଫଲାଇନ ଫସଲ ଡାକ୍ତର',
                d_healthy: 'ସୁସ୍ଥ ନିରୋଗୀ ଫସଲ', d_early: 'ଆଗୁଆ ପତ୍ରପୋଡ଼ା ଦାଗ', d_late: 'ପତ୍ରସଢ଼ା ଅଙ୍ଗମାରୀ ରୋଗ', d_curl: 'ହଳଦିଆ କୁନ୍ଥୁଆ ପତ୍ରମୋଡ଼ା'
            }
        };

        const langSelect = document.getElementById('langSelect');
        const fileInput = document.getElementById('fileInput');
        const dropArea = document.getElementById('dropArea');
        const previewSection = document.getElementById('preview-section');
        const previewImg = document.getElementById('previewImg');
        const analyzeBtn = document.getElementById('analyzeBtn');
        const resultSection = document.getElementById('result-section');
        const viewFullReportBtn = document.getElementById('viewFullReportBtn');
        let currentFile = null;
        let lastReportId = null;

        // Guaranteed immediate file selection & drag-drop binding
        function bindLeafUploader(file) {
            if (!file) return;
            currentFile = file;
            const reader = new FileReader();
            reader.onload = (ev) => {
                if (previewImg) previewImg.src = ev.target.result;
                if (previewSection) {
                    previewSection.style.display = 'block';
                    previewSection.scrollIntoView({ behavior: 'smooth' });
                }
            };
            reader.readAsDataURL(file);
        }

        if (fileInput) {
            fileInput.addEventListener('change', (e) => {
                if (e.target.files && e.target.files[0]) {
                    bindLeafUploader(e.target.files[0]);
                }
            });
        }

        if (dropArea) {
            dropArea.addEventListener('drop', (e) => {
                e.preventDefault();
                dropArea.style.borderColor = '#10b981';
                if (e.dataTransfer.files && e.dataTransfer.files[0]) {
                    bindLeafUploader(e.dataTransfer.files[0]);
                }
            });
        }

        function updateEntireUILanguage(lang) {
            const t = UI_TEXTS[lang] || UI_TEXTS['English'];
            if (document.getElementById('logoText')) document.getElementById('logoText').innerText = t.logo;
            if (document.getElementById('logoTag')) document.getElementById('logoTag').innerText = t.logoTag;
            if (document.getElementById('navHome')) document.getElementById('navHome').innerText = t.home;
            if (document.getElementById('navHistory')) document.getElementById('navHistory').innerText = t.history;
            if (document.getElementById('mainTitle')) document.getElementById('mainTitle').innerText = t.title;
            if (document.getElementById('mainSubtitle')) document.getElementById('mainSubtitle').innerText = t.subtitle;
            if (document.getElementById('mainDisclaimer')) document.getElementById('mainDisclaimer').innerText = t.disclaimer;
            if (document.getElementById('dropTitle')) document.getElementById('dropTitle').innerText = t.dropTitle;
            if (document.getElementById('dropOr')) document.getElementById('dropOr').innerText = t.dropOr;
            if (document.getElementById('browseBtnText')) document.getElementById('browseBtnText').innerText = t.browse;
            if (document.getElementById('fileHint')) document.getElementById('fileHint').innerText = t.fileHint;
            if (document.getElementById('previewTitle')) document.getElementById('previewTitle').innerText = t.previewTitle;
            if (document.getElementById('analyzeBtn')) document.getElementById('analyzeBtn').innerText = t.analyzeBtn;
            if (document.getElementById('curableLabel')) document.getElementById('curableLabel').innerText = t.curable;
            if (document.getElementById('severityLabel')) document.getElementById('severityLabel').innerText = t.severity;
            if (document.getElementById('confLabel')) document.getElementById('confLabel').innerText = t.conf;
            if (document.getElementById('origHeading')) document.getElementById('origHeading').innerText = t.origHeading;
            if (document.getElementById('maskHeading')) document.getElementById('maskHeading').innerText = t.maskHeading;
            if (document.getElementById('rxLblMed')) document.getElementById('rxLblMed').innerText = t.rxMed;
            if (document.getElementById('rxLblDose')) document.getElementById('rxLblDose').innerText = t.rxDose;
            if (document.getElementById('rxLblAction')) document.getElementById('rxLblAction').innerText = t.rxAction;

            const audioSpan = document.getElementById('audioBtnText');
            if (audioSpan) {
                audioSpan.innerText = t.audioBtn.replace('🔊 ', '');
            }
            viewFullReportBtn.innerText = t.reportBtn;

            if (document.getElementById('benchHeading')) document.getElementById('benchHeading').innerText = t.benchH;
            if (document.getElementById('benchSub')) document.getElementById('benchSub').innerText = t.benchS;
            if (document.getElementById('lblAcc')) document.getElementById('lblAcc').innerText = t.lblAcc;
            if (document.getElementById('lblAccSub')) document.getElementById('lblAccSub').innerText = t.lblAccS;
            if (document.getElementById('lblPrec')) document.getElementById('lblPrec').innerText = t.lblPrec;
            if (document.getElementById('lblPrecSub')) document.getElementById('lblPrecSub').innerText = t.lblPrecS;
            if (document.getElementById('lblRecall')) document.getElementById('lblRecall').innerText = t.lblRecall;
            if (document.getElementById('lblRecallSub')) document.getElementById('lblRecallSub').innerText = t.lblRecallS;
            if (document.getElementById('lblF1')) document.getElementById('lblF1').innerText = t.lblF1;
            if (document.getElementById('lblF1Sub')) document.getElementById('lblF1Sub').innerText = t.lblF1S;

            if (document.getElementById('recentHeading')) document.getElementById('recentHeading').innerText = t.recentH;
            if (document.getElementById('recentSub')) document.getElementById('recentSub').innerText = t.recentS;
            if (document.getElementById('recentViewAll')) document.getElementById('recentViewAll').innerText = t.recentAll;
            const thId = document.getElementById('thId');
            if (thId) {
                thId.innerText = t.thId;
                if (document.getElementById('thDate')) document.getElementById('thDate').innerText = t.thDate;
                if (document.getElementById('thDiag')) document.getElementById('thDiag').innerText = t.thDiag;
                if (document.getElementById('thConf')) document.getElementById('thConf').innerText = t.thConf;
                if (document.getElementById('thAction')) document.getElementById('thAction').innerText = t.thAction;
            }

            document.querySelectorAll('.recent-tag').forEach(tag => {
                const k = tag.getAttribute('data-key');
                if (k === 'class_D') tag.innerText = t.d_healthy;
                else if (k === 'class_A') tag.innerText = t.d_early;
                else if (k === 'class_B') tag.innerText = t.d_late;
                else tag.innerText = t.d_curl;
            });

            document.querySelectorAll('.recent-report-link').forEach(link => {
                link.innerText = t.btnViewRec;
            });

            if (document.getElementById('ftBadge')) document.getElementById('ftBadge').innerText = t.ftBadge;
            if (document.getElementById('ftDesc')) document.getElementById('ftDesc').innerText = t.ftDesc;
            document.getElementById('ftAuthor').innerHTML = t.ftAuthor.replace('Sahil Sexsena', '<span style="color: #34d399;">Sahil Sexsena</span>');
            if (document.getElementById('ftCopy')) document.getElementById('ftCopy').innerText = t.ftCopy;

            if (lastReportId) {
                viewFullReportBtn.href = `/report/${lastReportId}?lang=${lang}`;
            }
        }

        let activeLang = sessionStorage.getItem('tomatoiq_user_ui_lang');
        if (!activeLang) {
            activeLang = 'English';
            sessionStorage.setItem('tomatoiq_user_ui_lang', 'English');
        }

        langSelect.value = activeLang;
        updateEntireUILanguage(activeLang);

        langSelect.addEventListener('change', () => {
            const selectedLang = langSelect.value;
            sessionStorage.setItem('tomatoiq_user_ui_lang', selectedLang);
            updateEntireUILanguage(selectedLang);
            if (currentFile && resultSection.style.display === 'block') {
                analyzeBtn.click();
            }
        });

        dropArea.addEventListener('dragover', (e) => { e.preventDefault(); dropArea.style.borderColor = '#34d399'; });
        dropArea.addEventListener('dragleave', () => { dropArea.style.borderColor = '#10b981'; });
        function handleSelectedLeafFile(file) {
            if (!file) return;
            currentFile = file;
            const reader = new FileReader();
            reader.onload = (ev) => {
                previewImg.src = ev.target.result;
                previewSection.style.display = 'block';
                previewSection.scrollIntoView({ behavior: 'smooth' });
            };
            reader.readAsDataURL(file);
        }

        dropArea.addEventListener('drop', (e) => {
            e.preventDefault();
            dropArea.style.borderColor = '#10b981';
            if (e.dataTransfer.files && e.dataTransfer.files[0]) {
                handleSelectedLeafFile(e.dataTransfer.files[0]);
            }
        });

        fileInput.addEventListener('change', (e) => {
            if (e.target.files && e.target.files[0]) {
                handleSelectedLeafFile(e.target.files[0]);
            }
        });

        analyzeBtn.addEventListener('click', async () => {
            if (!currentFile) return;
            const currentLang = langSelect.value;
            const t = UI_TEXTS[currentLang] || UI_TEXTS['English'];
            analyzeBtn.innerText = t.analyzing;
            analyzeBtn.disabled = true;

            const formData = new FormData();
            formData.append('image', currentFile);
            formData.append('language', currentLang);

            try {
                const res = await fetch('/analyze', { method: 'POST', body: formData });
                const data = await res.json();
                
                if (data.error) {
                    alert(data.error);
                } else {
                    lastReportId = data.report_id;
                    viewFullReportBtn.href = `/report/${data.report_id}?lang=${currentLang}`;

                    if (document.getElementById('curableVal')) document.getElementById('curableVal').innerText = data.curable_pct + "%";
                    if (document.getElementById('severityVal')) document.getElementById('severityVal').innerText = "~" + data.severity_pct + "%";
                    if (document.getElementById('confVal')) document.getElementById('confVal').innerText = data.confidence + "%";

                    if (document.getElementById('diseaseName')) document.getElementById('diseaseName').innerText = data.disease_name;
                    if (document.getElementById('engineBadge')) document.getElementById('engineBadge').innerText = "🧠 " + (data.engine || "Llama 3.2 (ExecuTorch)");
                    if (document.getElementById('rxMedicine')) document.getElementById('rxMedicine').innerText = data.rx;
                    if (document.getElementById('rxDose')) document.getElementById('rxDose').innerText = data.dose;
                    if (document.getElementById('rxAction')) document.getElementById('rxAction').innerText = data.action;

                    document.getElementById('resOrigImg').src = data.orig_img;
                    document.getElementById('resMaskImg').src = data.mask_img;

                    const player = document.getElementById('offlineAudioPlayer');
                    player.style.display = 'none';
                    player.pause();
                    document.getElementById('playAudioBtn').innerHTML = `🔊 <span id="audioBtnText">${t.audioBtn.replace('🔊 ', '')}</span>`;

                    resultSection.style.display = 'block';
                    resultSection.scrollIntoView({ behavior: 'smooth' });
                }
            } catch (err) {
                alert("Server error: " + err);
            } finally {
                analyzeBtn.innerText = t.analyzeBtn;
                analyzeBtn.disabled = false;
            }
        });

        // Offline Audio Player Handler
        async function playOfflineAudio() {
            const btn = document.getElementById('playAudioBtn');
            const player = document.getElementById('offlineAudioPlayer');
            const disease = document.getElementById('diseaseName').innerText;
            const med = document.getElementById('rxMedicine').innerText;
            const dose = document.getElementById('rxDose').innerText;
            const action = document.getElementById('rxAction').innerText;

            const spokenText = `${disease}. Medicine: ${med}. Dose: ${dose}. Advisory: ${action}`;

            btn.innerHTML = (document.getElementById('langSelect')?.value === 'Hindi' ? '⏳ ऑडियो तैयार हो रहा है...' : document.getElementById('langSelect')?.value === 'Kannada' ? '⏳ ಆಡಿಯೋ ಸಿದ್ಧವಾಗುತ್ತಿದೆ...' : '⏳ Processing Audio...');
            btn.disabled = true;

            try {
                const res = await fetch('/generate_voice', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        report_id: lastReportId || 'temp',
                        text: spokenText
                    })
                });
                const data = await res.json();
                if (data.audio_url) {
                    player.src = data.audio_url + '?t=' + new Date().getTime();
                    player.style.display = 'inline-block';
                    player.play();
                    btn.innerHTML = (document.getElementById('langSelect')?.value === 'Hindi' ? '🔁 फिर से सुनें' : document.getElementById('langSelect')?.value === 'Kannada' ? '🔁 ಮತ್ತೆ ಕೇಳಿ' : '🔁 Repeat Audio');
                } else {
                    alert("Audio generate nahi ho paya");
                    btn.innerHTML = '🔊 <span id="audioBtnText">Kisan Audio Salah Sunein</span>';
                }
            } catch (e) {
                console.error(e);
                btn.innerHTML = '🔊 <span id="audioBtnText">Kisan Audio Salah Sunein</span>';
            } finally {
                btn.disabled = false;
            }
        }
    
        window.sendKisanChat = async function() {
            const inputEl = document.getElementById('chatInput');
            const boxEl = document.getElementById('chatHistoryBox');
            const btnEl = document.getElementById('chatSendBtn');
            if (!inputEl || !boxEl) return;

            const msg = inputEl.value.trim();
            if (!msg) return;

            const langEl = document.getElementById('langSelect');
            const lang = langEl ? langEl.value : 'English';
            const diseaseName = document.getElementById('diseaseName') ? document.getElementById('diseaseName').innerText : 'Tomato Disease';
            const rx = document.getElementById('rxMedicine') ? document.getElementById('rxMedicine').innerText : '';
            const dose = document.getElementById('rxDose') ? document.getElementById('rxDose').innerText : '';

            boxEl.innerHTML += `<div style="align-self: flex-end; background: #133126; color: #ecfdf5; padding: 8px 12px; border-radius: 10px; max-width: 82%;"><strong>You:</strong> ${msg}</div>`;
            inputEl.value = '';
            if (btnEl) {
                btnEl.disabled = true;
                btnEl.innerText = 'Thinking...';
            }
            boxEl.scrollTop = boxEl.scrollHeight;

            try {
                const res = await fetch('/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        message: msg,
                        language: lang,
                        disease_name: diseaseName,
                        rx: rx,
                        dose: dose
                    })
                });
                const data = await res.json();
                const replyText = data.reply || data.error || 'No response received.';
                boxEl.innerHTML += `<div style="align-self: flex-start; background: #0f231b; border: 1px solid rgba(52,211,153,0.3); color: #cbd5e1; padding: 8px 12px; border-radius: 10px; max-width: 88%;"><strong style="color:#34d399;">Kisan AI:</strong> ${replyText}</div>`;
                boxEl.scrollTop = boxEl.scrollHeight;
            } catch (err) {
                boxEl.innerHTML += `<div style="color: #f87171;">Error: ${err.message}</div>`;
            } finally {
                if (btnEl) {
                    btnEl.disabled = false;
                    btnEl.innerText = 'Ask AI';
                }
            }
        };

        document.addEventListener('DOMContentLoaded', () => {
            const chatBtn = document.getElementById('chatSendBtn');
            const chatIn = document.getElementById('chatInput');
            if (chatBtn) {
                chatBtn.onclick = () => window.sendKisanChat();
            }
            if (chatIn) {
                chatIn.onkeydown = (ev) => {
                    if (ev.key === 'Enter') {
                        ev.preventDefault();
                        window.sendKisanChat();
                    }
                };
            }
        });
    
        const langSelAudio = document.getElementById('langSelect');
        if (langSelAudio) {
            langSelAudio.addEventListener('change', () => {
                const l = langSelAudio.value;
                const pBtn = document.getElementById('playVoiceBtn');
                const aPlayer = document.getElementById('offlineAudioPlayer');
                if (pBtn) {
                    const isReplay = aPlayer && aPlayer.style.display !== 'none' && aPlayer.src;
                    const initMap = {
                        'English': '🔊 Listen to Audio Advisory',
                        'Hindi': '🔊 ऑडियो सलाह सुनें',
                        'Kannada': '🔊 ಆಡಿಯೋ ಸಲಹೆ ಕೇಳಿ'
                    };
                    const repMap = {
                        'English': '🔁 Listen Again',
                        'Hindi': '🔁 फिर से सुनें',
                        'Kannada': '🔁 ಮತ್ತೆ ಕೇಳಿ'
                    };
                    pBtn.innerText = isReplay ? (repMap[l] || repMap['English']) : (initMap[l] || initMap['English']);
                }
            });
        }

    </script>
</body>
</html>